# --- Build output ---------------------------------------------------------
build/
flutter_app/build/
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
native/vice_core/linux/build/
native/vice_core/android/build/
native/vice_core/linux/build_verify/

# Native libraries ARE tracked where the app consumes them
# (flutter_app/android/app/src/main/jniLibs/** and flutter_app/ios/Frameworks/**)
# -- CI needs them to build the AAB and the IPA, and rebuilding them requires
# the cross-compiled VICE object tree which lives outside this repo. Note that
# the `build/` rule above already hides native/vice_core/*/build/, which is
# where those files are produced; the committed copies are the ones both
# toolchains actually read. See docs/NATIVE_BUILD.md.

# --- Local machine config (paths, SDK locations) --------------------------
flutter_app/android/local.properties
flutter_app/android/.gradle/
flutter_app/android/app/.cxx/
local.properties
.gradle/

# --- Signing material: never commit ---------------------------------------
*.jks
*.keystore
key.properties
**/keystore.properties
*secret*

# --- IDE / editor ---------------------------------------------------------
.idea/
.vscode/
*.iml
compile_commands.json

# --- OS -------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Test scratch output --------------------------------------------------
*.ppm
*.vsf
/tmp/
native/vice_core/linux/test/testdata/*.wav

# --- Commercial game images: NOT redistributable --------------------------
# The native smoke/snapshot tests run against real C64 titles, but those are
# copyrighted commercial software and must not ship in a public repo. Point
# the tests at your own local copies instead -- every test takes the media
# path as an argument. See docs/NATIVE_BUILD.md.
native/vice_core/linux/test/testdata/games/

# asc CLI review artifacts
.asc/

# Commodore's ROMs, fetched by tools/fetch-test-roms.sh for local testing.
# Kept out of the public repo: shipping or committing them is redistribution
# that is not ours to do (see the script's own header).
docs/*.zip

# Xcode leaves these beside the repo after a Distribute App export.
Runner */

# Per-user Xcode state, written by any local build.
**/xcuserdata/
# Xcode's resolved Swift Package graph. Regenerated on every build from the
# package refs already in the project, and it records absolute paths from
# whichever machine ran the build.
**/xcshareddata/swiftpm/

# App Store Connect API private key. Account-wide, downloads from Apple
# exactly once, and cannot be rotated in place -- it never belongs in git.
# See docs/APPSTORE_CREDENTIALS.md for how to move it between machines.
*.p8
