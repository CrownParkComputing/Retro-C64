#!/usr/bin/env bash
# C++ counterpart of ios-clang -- reSID and a few other VICE pieces are C++.
# Same reasoning as ios-clang for the linker flags; see that file.
set -euo pipefail

: "${IOS_SDK:?IOS_SDK not set}"
: "${IOS_LD:?IOS_LD not set}"
IOS_MIN="${IOS_MIN:-13.0}"
IOS_SDK_VERSION="${IOS_SDK_VERSION:-16.0}"
IOS_TARGET="${IOS_TARGET:-arm64-apple-ios${IOS_MIN}}"

compile_only=false
for arg in "$@"; do
    case "$arg" in
        -c|-E|-S|-M|-MM) compile_only=true ;;
    esac
done

if $compile_only; then
    exec /usr/bin/clang++ -target "$IOS_TARGET" -isysroot "$IOS_SDK" "$@"
fi

exec /usr/bin/clang++ \
    -target "$IOS_TARGET" \
    -isysroot "$IOS_SDK" \
    -fuse-ld="$IOS_LD" \
    -Wl,-arch,arm64 \
    -Wl,-platform_version,ios,"${IOS_MIN}.0","${IOS_SDK_VERSION}.0" \
    -Wl,-adhoc_codesign \
    "$@"
